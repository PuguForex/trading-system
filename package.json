{
  "name": "trading-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --filter=trading-client",
    "lint": "eslint . --ext .ts",
    "dev": "turbo run dev --filter=web-client --parallel",
    "dev:api": "npm run start -w api-service",
    "dev:web": "npm run dev -w web-client",
    "dev:python": "cd apps/python-service && uv run python main.py",
    "start:client": "npm run start -w trading-client",
    "clean": "rimraf apps/*/dist packages/*/dist .turbo",
    "build:all": "npm run build",
    "rebuild": "npm run clean && npm run build:all",
    "build:web": "npm run build -w web-client",
    "preview:web": "npm run preview -w web-client",
    "reset": "npm run clean && npm install && npm run build",
    "health": "node -e \"console.log('System OK')\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --write",
      "eslint"
    ],
    "**/*.{js,json,md,yml,yaml}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "concurrently": "9.2.1",
    "eslint": "10.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "rimraf": "6.1.3",
    "turbo": "2.9.18",
    "typescript-eslint": "8.60.1"
  },
  "overrides": {
    "ip-address": "10.1.1"
  },
  "packageManager": "npm@10.9.4"
}
